{
    "name": "smhg/date-frequency",
    "description": "Temporal frequency library",
    "license": "MIT",
    "keywords": [
        "frequency",
        "date",
        "time",
        "temporal",
        "cron"
    ],
    "authors": [
        {
            "name": "smhg",
            "email": "sam@strictlyphp.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-0": {
            "Frequency": "src/"
        }
    },
    "scripts": {
        "test": "APPLICATION_ENV=test phpunit",
        "lint": "phpmd src ansi unusedcode,design",
        "analyze": "phpstan analyze"
    }
}
